{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Faces live webcam observation contract candidate v1",
  "description": "Controller-only reviewed design candidate. Shape validation does not verify permission, model execution, evaluation, reviewer authentication, or clinical status. Cross-field invariants and external trust checks are mandatory in OBSERVATION_V1.md. Fingerprints use RFC 8785 JCS on the entire envelope; finite IEEE-754 numbers and integer values at most 2^53-1. Dedicated evaluation permission is independent of routine demo capture.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "faces-live-observation-v1"
        },
        "message_kind": {
          "const": "capture_permission"
        },
        "record": {
          "$ref": "#/$defs/permission"
        }
      },
      "required": [
        "schema_version",
        "message_kind",
        "record"
      ]
    },
    {
