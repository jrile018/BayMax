  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "camera_session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "arrival_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "arrival_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capture_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "source_kind": {
          "const": "live_webcam"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "orientation": {
          "const": "upright_raw_raster"
        },
        "permission_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "frame_id",
        "camera_session_id",
        "arrival_id",
        "arrival_revision",
        "capture_id",
        "capture_revision",
        "source_kind",
        "captured_at",
        "source_image_sha256",
        "image_sha256",
        "width",
        "height",
        "orientation",
        "permission_receipt_sha256"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "weights_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "processor_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decoding_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "model_id",
        "model_revision",
        "weights_manifest_sha256",
        "processor_manifest_sha256",
        "runtime_manifest_sha256",
        "prompt_sha256",
        "decoding_config_sha256",
        "adapter_source_sha256"
      ]
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera_session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "arrival_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "assigned_role": {
          "enum": [
            "volunteer"
          ]
        },
        "purposes": {
          "type": "array",
          "items": {
            "enum": [
              "preview_face_localization",
              "capture",
              "visual_assessment",
              "private_display",
              "human_review"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 5
        },
        "consent_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rights_review_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "retention_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "withdrawal_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "session_scope": {
          "const": "private_exercise"
        },
        "capture_source": {
          "const": "live_webcam"
        },
        "staging_label": {
          "enum": [
            "ordinary_appearance",
            "non_injury_stage_makeup"
          ]
        },
        "public_use_allowed": {
          "const": false
        },
        "dataset_reuse_allowed": {
          "const": false
        },
        "derived_retention_deadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "camera_session_id",
        "arrival_id",
        "actor_id",
        "assigned_role",
        "purposes",
        "consent_receipt_sha256",
        "rights_review_receipt_sha256",
        "issued_at",
        "expires_at",
        "retention_deadline",
        "withdrawal_epoch",
        "session_scope",
        "capture_source",
        "staging_label",
        "public_use_allowed",
        "dataset_reuse_allowed",
        "derived_retention_deadline"
      ]
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "status": {
          "enum": [
            "localized",
            "no_face",
            "occluded",
            "failed",
            "multiple_faces"
          ]
        },
        "boxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/box"
          },
          "maxItems": 50
        },
        "selected_face_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "actual_detector",
            "contract_test_fixture"
          ]
        },
        "execution_receipt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "face_localized",
            "no_face_found",
            "face_occluded",
            "detector_failed",
            "multiple_faces_ambiguous",
            "capture_unusable"
          ]
        },
        "round_trip_ms": {
          "type": "number",
          "minimum": 0
        },
        "capture_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "frame",
        "artifact",
        "status",
        "boxes",
        "selected_face_index",
        "origin",
        "execution_receipt_sha256",
        "reason",
        "round_trip_ms",
        "capture_receipt_sha256"
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "category": {
          "enum": [
            "bruise_like_discoloration",
            "cut_or_abrasion",
            "visible_blood"
          ]
        },
        "region": {
          "$ref": "#/$defs/box"
        },
        "reason_code": {
          "enum": [
            "bruise_like_color_pattern",
            "visible_surface_break",
            "visible_red_fluid"
          ]
        }
      },
      "required": [
        "cue_id",
        "category",
        "region",
        "reason_code"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "localization_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "outcome": {
          "enum": [
            "possible_visible_concern",
            "no_visible_concern_detected",
            "unable_to_assess"
          ]
        },
        "assessment_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/box"
            },
            {
              "type": "null"
            }
          ]
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          },
          "maxItems": 16
        },
        "reason_code": {
          "enum": [
            "supported_visible_cue",
            "no_supported_cue_in_region",
            "face_not_localized",
            "multiple_faces_ambiguous",
            "capture_unusable",
            "unsupported_input",
            "evaluation_not_accepted",
            "runner_unavailable",
            "runner_failed",
            "invalid_runner_output",
            "stale_capture",
            "permission_invalid",
            "category_not_evaluated",
            "uncertain_visible_evidence"
          ]
        },
        "origin": {
          "enum": [
            "actual_evaluated_runner",
            "unavailable",
            "contract_test_fixture",
            "scripted_training"
          ]
        },
        "evaluation_receipt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_receipt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "operational_eligible": {
          "const": false
        },
        "capture_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "observation_id",
        "frame",
        "localization_receipt_sha256",
        "outcome",
        "assessment_region",
        "cues",
        "reason_code",
        "origin",
        "evaluation_receipt_sha256",
        "execution_receipt_sha256",
        "created_at",
        "latency_ms",
        "operational_eligible",
        "capture_receipt_sha256"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "task": {
          "const": "visible_facial_concerns"
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "bruise_like_discoloration",
              "cut_or_abrasion",
              "visible_blood"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dataset_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "split_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "metrics_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "const": "consented_staged_webcam_demo"
        },
        "decision": {
          "enum": [
            "accepted_for_staged_demo",
            "rejected",
            "incomplete"
          ]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluation_permission_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "evaluation_id",
        "artifact",
        "task",
        "categories",
        "plan_sha256",
        "dataset_manifest_sha256",
        "split_manifest_sha256",
        "metrics_sha256",
        "review_receipt_sha256",
        "scope",
        "decision",
        "evaluated_at",
        "evaluation_permission_manifest_sha256"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "observation_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "arrival_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "capture_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "capture_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "reviewer_identity_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assigned_role": {
          "const": "care_reviewer"
        },
        "decision": {
          "enum": [
            "confirm_visible_concern",
            "no_additional_visible_concern",
            "needs_further_human_review"
          ]
        },
        "confirmed_cue_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "operational_eligible": {
          "const": false
        }
      },
      "required": [
        "review_id",
        "observation_fingerprint",
        "arrival_id",
        "capture_id",
        "capture_revision",
        "reviewer_id",
        "reviewer_identity_receipt_sha256",
        "assigned_role",
        "decision",
        "confirmed_cue_ids",
        "reviewed_at",
        "operational_eligible"
      ]
    },
    "runner_output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "possible_visible_concern",
            "no_visible_concern_detected",
            "unable_to_assess"
          ]
        },
        "assessment_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/box"
            },
            {
              "type": "null"
            }
          ]
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          },
          "maxItems": 16
        },
        "reason_code": {
          "enum": [
            "supported_visible_cue",
            "no_supported_cue_in_region",
            "face_not_localized",
            "multiple_faces_ambiguous",
            "capture_unusable",
            "unsupported_input",
            "evaluation_not_accepted",
            "runner_unavailable",
            "runner_failed",
            "invalid_runner_output",
            "stale_capture",
            "permission_invalid",
            "category_not_evaluated",
            "uncertain_visible_evidence"
          ]
        }
      },
      "required": [
        "outcome",
        "assessment_region",
        "cues",
        "reason_code"
